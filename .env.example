# Copie para .env (cp .env.example .env) e ajuste. O .env é lido pelo Docker Compose e nunca
# vai para o repositório.

# JWT — obrigatório. O valor abaixo é um marcador e é RECUSADO pela aplicação na subida:
# gere um segredo próprio com `openssl rand -base64 48` e substitua antes de subir.
JWT_SECRET=troque-este-segredo-por-um-valor-grande-de-no-minimo-256-bits
JWT_EXPIRATION=3600000

# Banco de dados. Nome, usuário e senha valem para o container do PostgreSQL e para a aplicação.
DB_NAME=restaurantes-app
DB_USER=postgres
DB_PASSWORD=postgres

# --- Só para rodar a aplicação FORA do Docker (IDE ou mvn spring-boot:run) -----------------
# Dentro do Compose, a aplicação fala com os serviços pelo nome (db, mailpit) e ignora estes
# valores. Fora dele, `localhost` alcança as portas que o Compose publica — suba só os
# serviços de apoio com `docker compose up -d db mailpit`.
DB_HOST=localhost
DB_PORT=5432
MAIL_HOST=localhost
MAIL_PORT=1025

# E-mail. Os e-mails de redefinição de senha aparecem no Mailpit: http://localhost:8025
MAIL_FROM=no-reply@restaurantes.postech
MAIL_RESET_TOKEN_EXPIRATION_MINUTES=30

# Provedor SMTP real (fora do Docker): troque host/porta acima e habilite autenticação.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
