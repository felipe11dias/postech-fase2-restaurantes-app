# Copie para .env (cp .env.example .env) e ajuste. O .env é lido pelo Docker Compose e nunca
# vai para o repositório.

# JWT — obrigatório. O valor abaixo é um marcador e é RECUSADO pela aplicação na subida:
# gere um segredo próprio com `openssl rand -base64 48` e substitua antes de subir.
JWT_SECRET=troque-este-segredo-por-um-valor-grande-de-no-minimo-256-bits
JWT_EXPIRATION=3600000

# Banco de dados. Nome, usuário e senha valem para o container do PostgreSQL e para a aplicação.
DB_NAME=restaurantes-app
DB_USER=postgres
DB_PASSWORD=postgres

# E-mail. Os e-mails de redefinição de senha aparecem no Mailpit: http://localhost:8025
MAIL_FROM=no-reply@restaurantes.postech
MAIL_RESET_TOKEN_EXPIRATION_MINUTES=30

# --- Portas no host -----------------------------------------------------------------------
# Onde cada serviço do Compose aparece nesta máquina (sempre só em 127.0.0.1). Se outra coisa
# já ocupa a porta — por exemplo, a Fase 1 rodando em 5432 e 8080 —, troque aqui: DB_PORT=5433,
# APP_PORT=8081. A aplicação fora do Docker usa estes mesmos DB_PORT e MAIL_PORT para chegar
# aos serviços.
APP_PORT=8080
DB_PORT=5432
MAIL_PORT=1025
MAILPIT_UI_PORT=8025

# --- Só para rodar a aplicação FORA do Docker (IDE ou mvn spring-boot:run) -----------------
# Dentro do Compose, a aplicação fala com os serviços pelo nome (db, mailpit) e ignora tudo
# daqui para baixo. Fora dele, `localhost` alcança as portas publicadas acima — suba só os
# serviços de apoio com `docker compose up -d db mailpit`.
DB_HOST=localhost
MAIL_HOST=localhost

# Provedor SMTP real: troque MAIL_HOST/MAIL_PORT e habilite autenticação. Dentro do Compose o
# e-mail vai sempre para o Mailpit, e estes valores não chegam à aplicação.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
