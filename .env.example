# Banco de dados
DB_NAME=restaurantes-app
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# JWT — obrigatório. O valor abaixo é um marcador e é RECUSADO pela aplicação na subida:
# gere um segredo próprio com `openssl rand -base64 48` e substitua antes de subir.
JWT_SECRET=troque-este-segredo-por-um-valor-grande-de-no-minimo-256-bits
JWT_EXPIRATION=3600000

# E-mail (recuperação de senha) — defaults apontam para um SMTP local de testes.
# Para um provedor real, troque host/porta/usuário/senha e habilite auth/starttls.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@restaurantes.postech
MAIL_RESET_TOKEN_EXPIRATION_MINUTES=30
